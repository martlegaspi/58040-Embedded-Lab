# Lab 12: Integrated IoT Hub (Ultrasonic + PIR + Tkinter GUI + Firebase Cloud)
import tkinter as tk
import serial
import threading
import time
import firebase_admin
from firebase_admin import credentials, db

# --- 1. Configuration ---
SERIAL_PORT = '/dev/ttyACM0'  # Change to '/dev/ttyUSB0' if needed
BAUD_RATE = 9600
FIREBASE_URL = 'https://embedded-lab-11-default-rtdb.asia-southeast1.firebasedatabase.app/'  # Replace with your Firebase URL

# --- 2. Initialize Firebase ---
cred = credentials.Certificate('serviceAccountKey.json')
firebase_admin.initialize_app(cred, {'databaseURL': FIREBASE_URL})
readings_ref = db.reference('lab12_readings')
actuator_ref = db.reference('lab12_actuator')

# --- 3. Initialize Serial Link ---
ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
time.sleep(2)  # Allow Arduino serial reset to complete

class IoTDashboard:
    def __init__(self, root):
        self.root = root
        self.root.title("Lab 12: End-to-End IoT System Dashboard")
        self.root.geometry("430x290")
        self.running = True
        self.actuator_state = "OFF"

        # UI Labels
        tk.Label(root, text="Integrated IoT Monitoring & Control", font=("Arial", 14, "bold")).pack(pady=10)
        self.dist_var = tk.StringVar(value="Ultrasonic Distance: Waiting...")
        self.pir_var = tk.StringVar(value="PIR Motion Sensor: Waiting...")
        self.latency_var = tk.StringVar(value="Cloud Upload RTT: -- ms")
        self.status_var = tk.StringVar(value="LED Actuator State: OFF")

        tk.Label(root, textvariable=self.dist_var, font=("Arial", 12)).pack(pady=4)
        tk.Label(root, textvariable=self.pir_var, font=("Arial", 12)).pack(pady=4)
        tk.Label(root, textvariable=self.latency_var, font=("Arial", 11)).pack(pady=4)
        tk.Label(root, textvariable=self.status_var, font=("Arial", 12, "bold")).pack(pady=6)

        # Actuator Control Buttons
        btn_frame = tk.Frame(root)
        btn_frame.pack(pady=10)
        tk.Button(btn_frame, text="Turn LED ON", bg="#4CAF50", fg="white", width=16,
                  command=lambda: self.set_actuator("ON")).pack(side=tk.LEFT, padx=8)
        tk.Button(btn_frame, text="Turn LED OFF", bg="#F44336", fg="white", width=16,
                  command=lambda: self.set_actuator("OFF")).pack(side=tk.LEFT, padx=8)

        # Start background thread for serial + cloud pipeline
        threading.Thread(target=self.data_pipeline, daemon=True).start()

    def set_actuator(self, state):
        self.actuator_state = state
        ser.write(f"{state}\n".encode())
        actuator_ref.set({'state': state, 'updated_at': time.time()})
        self.status_var.set(f"LED Actuator State: {state}")
        print(f"[ACTUATOR] Command sent to Arduino & synced to Cloud: {state}")

    def data_pipeline(self):
        while self.running:
            try:
                # Check if a remote device changed the actuator state in Firebase
                cloud_cmd = actuator_ref.child('state').get()
                if cloud_cmd in ("ON", "OFF") and cloud_cmd != self.actuator_state:
                    self.set_actuator(cloud_cmd)

                # Read incoming sensor frame from Arduino: "distance_cm,motion"
                if ser.in_waiting > 0:
                    line = ser.readline().decode('utf-8').strip()
                    if ',' in line:
                        dist_str, motion_str = line.split(',')
                        distance_cm = float(dist_str)
                        motion_val = int(motion_str)

                        # Push to Firebase & measure round-trip time
                        t0 = time.time()
                        readings_ref.push({
                            'ts': t0,
                            'distance_cm': distance_cm,
                            'motion': motion_val,
                            'actuator': self.actuator_state
                        })
                        rtt_ms = (time.time() - t0) * 1000

                        # Update local Tkinter GUI
                        dist_display = f"{distance_cm:.1f} cm" if distance_cm >= 0 else "Out of Range"
                        self.dist_var.set(f"Ultrasonic Distance: {dist_display}")
                        self.pir_var.set(f"PIR Motion Sensor: {'MOTION DETECTED' if motion_val == 1 else 'NO MOTION'}")
                        self.latency_var.set(f"Cloud Upload RTT: {rtt_ms:.2f} ms")
                        print(f"[PIPELINE] Distance={dist_display} | PIR={motion_val} | Cloud RTT={rtt_ms:.2f} ms")

            except Exception as e:
                print(f"[ERROR] Pipeline exception: {e}")
            time.sleep(0.5)

if __name__ == '__main__':
    root = tk.Tk()
    app = IoTDashboard(root)
    root.mainloop()
