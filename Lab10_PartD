# Lab 10 Part D: 20-Trial Detection-to-Action Evaluation (With Buffer Flush)
import cv2
import numpy as np
import serial
import time

ser = serial.Serial('/dev/ttyACM0', 9600, timeout=1)
time.sleep(2)
cap = cv2.VideoCapture(0)

TOTAL_TRIALS = 20
latencies = []
correct_count = 0
incorrect_count = 0

print("=== Lab 10 Part D: 20-Trial Loop Evaluation ===")
print("Recommended: Run 10 trials with RED OBJECT PRESENT, and 10 trials with OBJECT ABSENT.\n")

for trial in range(1, TOTAL_TRIALS + 1):
    expected_str = input(f"Trial {trial}/{TOTAL_TRIALS} - Is red object PRESENT? (y/n): ").strip().lower()
    expected = (expected_str == 'y')

    # Flush stale buffered frames from the camera queue before timing
    for _ in range(5):
        cap.grab()

    # Start timer right before fresh frame capture & processing
    t_start = time.time()
    ok, frame = cap.read()
    if not ok:
        print("Camera read error.")
        break

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    # Slightly wider saturation/value floor (80, 50) to handle indoor lighting
    mask1 = cv2.inRange(hsv, (0, 80, 50), (10, 255, 255))
    mask2 = cv2.inRange(hsv, (170, 80, 50), (180, 255, 255))
    mask = cv2.bitwise_or(mask1, mask2)

    red_pixels = cv2.countNonZero(mask)
    detected = red_pixels > 500
    ser.write(b'1' if detected else b'0')

    # Wait for Arduino ACK to complete the detection-to-action round trip
    ack = ser.readline().decode('utf-8').strip()
    t_end = time.time()

    latency_ms = (t_end - t_start) * 1000.0
    latencies.append(latency_ms)

    is_correct = (detected == expected)
    if is_correct:
        correct_count += 1
        outcome = "CORRECT"
    else:
        incorrect_count += 1
        outcome = "INCORRECT"

    print(f"  -> Pixels: {red_pixels} | Detected: {detected} | ACK: '{ack}' | Result: {outcome} | Latency: {latency_ms:.2f} ms\n")

# Summary Statistics
accuracy = (correct_count / TOTAL_TRIALS) * 100.0
mean_latency = sum(latencies) / len(latencies) if latencies else 0.0
min_latency = min(latencies) if latencies else 0.0
max_latency = max(latencies) if latencies else 0.0

print("=== Final Evaluation Summary (Copy to Table 2) ===")
print(f"Trials (present / absent): {TOTAL_TRIALS} (10 present / 10 absent)")
print(f"Correct actions: {correct_count}")
print(f"Incorrect actions: {incorrect_count}")
print(f"Detection accuracy (%): {accuracy:.1f}%")
print(f"Detection-to-action latency (ms): {mean_latency:.2f} ms (Min: {min_latency:.2f} ms, Max: {max_latency:.2f} ms)")

cap.release()
ser.close()
