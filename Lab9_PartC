# Lab 9 TCP Client on the PC: receive data and measure network latency
import socket
import time

# --- Configuration ---
PI_IP = '192.168.177.101'  # Replace with your Pi's actual IP address from hostname -I
PORT = 5000

def run_client():
    # 1. Create client socket and connect to the Pi server
    client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    
    print(f"[CLIENT] Connecting to Raspberry Pi at {PI_IP}:{PORT}...")
    client_socket.connect((PI_IP, PORT))
    print("[CLIENT] Connected! Receiving sensor stream...\n")
    
    latencies = []
    
    try:
        # 2. Receive 20 data samples to measure network latency
        for i in range(20):
            # Receive up to 1024 bytes from the TCP buffer
            data = client_socket.recv(1024).decode().strip()
            
            if not data:
                break
                
            # Parse payload sent from server: "timestamp, sensor_value"
            sent_str, sensor_value = data.split(',')
            sent_time = float(sent_str)
            receive_time = time.time()
            
            # Calculate end-to-end latency in milliseconds
            latency_ms = (receive_time - sent_time) * 1000
            latencies.append(latency_ms)
            
            print(f"Sample {i+1:02d} | Received Value: {sensor_value:>4} | Latency: {latency_ms:.2f} ms")
            
        # 3. Calculate mean latency over the 20 samples
        if latencies:
            mean_latency = sum(latencies) / len(latencies)
            print(f"\n[SUMMARY] Transmission complete.")
            print(f"[SUMMARY] Mean Data Latency: {mean_latency:.2f} ms")
            
    except Exception as e:
        print(f"[ERROR] Connection error: {e}")
    finally:
        client_socket.close()
        print("[CLIENT] Socket closed.")

if __name__ == '__main__':
    run_client()
