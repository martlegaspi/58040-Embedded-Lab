# Lab 11: Push sensor data to Firebase Realtime Database and measure latency
import firebase_admin
from firebase_admin import credentials, db
import time
import random

# 1. Authenticate using the downloaded service account key
cred = credentials.Certificate('serviceAccountKey.json')
firebase_admin.initialize_app(cred, {
    'databaseURL': 'https://embedded-lab-11-default-rtdb.asia-southeast1.firebasedatabase.app/'  # Replace with your actual URL
})

ref = db.reference('readings')
latencies = []

print("Starting upload of 30 sensor readings to Firebase...\n")

# 2. Push 30 records and measure round-trip upload time
for i in range(30):
    sensor_value = random.randint(0, 1023)  # Replace with actual sensor read if wired
    payload = {
        'ts': time.time(),
        'light': sensor_value
    }
    
    t_start = time.time()
    ref.push(payload)
    t_end = time.time()
    
    rtt_ms = (t_end - t_start) * 1000
    latencies.append(rtt_ms)
    
    print(f"Record {i+1:02d}/30 | Value: {sensor_value:>4} | Upload RTT: {rtt_ms:.2f} ms")
    time.sleep(1)

# 3. Display mean round-trip latency
mean_rtt = sum(latencies) / len(latencies)
print("\n==========================================")
print(f"Total Records Uploaded: {len(latencies)}")
print(f"Mean Upload Round-Trip Latency: {mean_rtt:.2f} ms")
print("==========================================")
